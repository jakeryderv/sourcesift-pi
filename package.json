{
  "name": "sourcesift-pi",
  "version": "0.1.0",
  "private": true,
  "description": "ssift: a research agent over registered sources with cited evidence, built on pi.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "bin": {
    "ssift": "./bin/ssift.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "chat": "node bin/ssift.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "test": "node --test \"test/**/*.test.ts\"",
    "eval": "node scripts/eval.ts"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.14",
    "robots-parser": "3.0.1",
    "rss-parser": "3.13.0",
    "undici": "8.10.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
